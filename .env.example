# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — the SAME project as ns-home / ns-order-stages (same users, logins and permissions).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used for activity logs.
SUPABASE_SERVICE_ROLE_KEY=

# Odoo — server only. The app uses READ-ONLY calls only (search_read / read / search_count / fields_get / read_group).
# Same values as ns-order-stages.
ODOO_URL=https://<your-company>.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# Local development only: skip the login with a demo administrator (`npm run dev` only, never in production).
# Put this line in .env.development.local:
# NS_DEMO_DATA=1

# Supabase Storage (optional — these are the defaults):
# COMMISSIONS_BUCKET=naguib-selim-db
# COMMISSIONS_FOLDER=ns-sales-rep-commissions
# COMMISSIONS_TARGET_FOLDER=Wholesales_Target
