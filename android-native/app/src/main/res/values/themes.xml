<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: brand-coloured splash with the NS mark (androidx core-splashscreen). -->
    <style name="Theme.NS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.NS</item>
    </style>

    <!-- App theme after launch; Compose draws the screens edge to edge. -->
    <style name="Theme.NS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
